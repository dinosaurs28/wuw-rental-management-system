generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum KycType {
  DL
  AADHAAR
  PAN
  STUDENT_ID
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleStatus {
  AVAILABLE
  OUT_FOR_RENTAL
  MAINTENANCE
  INACTIVE
  MANAGER_REPORTED
}

enum BookingStatus {
  HOLD
  CONFIRMED
  PICKED_UP
  RETURNED
  CANCELLED
  HOLD_EXPIRED
}

enum BookingPhotoType {
  PRE_DELIVERY
  POST_RETURN
  DAMAGE
}

enum DepositMethod {
  ONLINE_RAZORPAY
  CASH
  UPI
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  PENDING
  APPROVED
  FINALIZED
  PAID
}

enum PricingRuleType {
  WEEKDAY
  WEEKEND
  PEAK
  CUSTOM
}

enum VehicleReturnDisposition {
  AVAILABLE
  MAINTENANCE
  DAMAGED
}

enum DamageReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DamageChargeType {
  PENALTY
  COMPENSATION
}

enum RentalPeriodType {
  HOURLY
  HALF_DAY
  FULL_DAY
  MULTI_DAY
  MONTHLY
}

enum SwapReason {
  CUSTOMER_REQUEST
  MAINTENANCE
  UPGRADE
  DOWNGRADE
  DAMAGE
  OTHER
}

// USER & AUTH

model User {
  id              Int          @id @default(autoincrement())
  publicId        String       @unique
  name            String
  email           String       @unique
  passwordHash    String?
  phone           String       @default("")
  authProvider    AuthProvider @default(PASSWORD)
  emailVerifiedAt DateTime?
  role            Role
  branchId        Int?
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)

  emailOtps               EmailVerificationOtp[]
  providers               UserProvider[]
  customerProfile         Customer?
  actorAuditLogs          AuditLog[]             @relation("ActorAuditLogs")
  approverAuditLogs       AuditLog[]             @relation("ApproverAuditLogs")
  bookingsCreated         Booking[]              @relation("BookingCreator")
  approvedDamageReports   DamageReport[]
  vehicleSwaps            VehicleSwap[]
  discountRulesCreated    DiscountRule[]         @relation("DiscountRuleCreator")
  manualDiscountsIssued   ManualDiscount[]       @relation("ManualDiscountIssuer")
  manualDiscountsApproved ManualDiscount[]       @relation("ManualDiscountApprover")
  collectedPayments       PaymentTransaction[]   @relation("PaymentCollector")
  confirmedPayments       PaymentTransaction[]   @relation("PaymentConfirmer")
  rejectedPayments        PaymentTransaction[]   @relation("PaymentRejector")
  openShifts              CashShift[]            @relation("ShiftEmployee")
  reconciledShifts        CashShift[]            @relation("ShiftReconciler")
  refundRequestsMade      RefundRequest[]        @relation("RefundRequester")
  refundRequestsApproved  RefundRequest[]        @relation("RefundApprover")
  refundRequestsCompleted RefundRequest[]        @relation("RefundCompleter")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  deletedAt               DateTime?

  @@index([branchId])
  @@index([role])
}

model UserProvider {
  id             Int          @id @default(autoincrement())
  publicId       String       @unique
  userId         Int
  provider       AuthProvider
  providerUserId String
  accessToken    String?
  refreshToken   String?
  user           User         @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerUserId], map: "provider_providerUserId_unique")
}

model EmailVerificationOtp {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  phone     String
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// CUSTOMER & KYC

model Customer {
  id                 Int           @id @default(autoincrement())
  publicId           String        @unique
  userId             Int           @unique
  user               User          @relation(fields: [userId], references: [id])
  alternatePhone     String?
  dob                String?
  addressLine1       String        @default("")
  city               String        @default("")
  state              String        @default("")
  country            String        @default("India")
  zipCode            String        @default("")
  isProfileCompleted Boolean       @default(false)
  kycs               CustomerKyc[]
  bookings           Booking[]

  cancellationInvoices CancellationInvoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model CustomerKyc {
  id         Int       @id @default(autoincrement())
  publicId   String    @unique
  customerId Int
  type       KycType
  fileId     Int
  status     KycStatus @default(PENDING)

  customer Customer   @relation(fields: [customerId], references: [id])
  file     FileObject @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now())

  @@unique([customerId, type])
  @@index([customerId])
  @@index([fileId])
}

// FILE STORAGE (Cloudflare R2)

model FileObject {
  id                   Int                   @id @default(autoincrement())
  publicId             String                @unique
  key                  String
  url                  String
  mime                 String
  size                 Int
  createdAt            DateTime              @default(now())
  bookingPhotos        BookingPhoto[]
  customerKycs         CustomerKyc[]
  bookingKycs          Booking[]             @relation("BookingKyc")
  vehicleImages        VehicleImage[]
  invoicePdfs          Invoice[]             @relation("InvoicePdf")
  cancellationInvoices CancellationInvoice[] @relation("CancellationInvoicePdf")

  @@index([publicId])
}

// BRANCH & STAFF

model Branch {
  id                      Int                         @id @default(autoincrement())
  publicId                String                      @unique
  name                    String
  address                 String
  phone                   String?
  users                   User[]
  vehicles                Vehicle[]
  bookings                Booking[]
  pricingSetting          BranchPricingSetting?
  pricingDiscountSlabs    PricingDiscountSlab[]
  categoryDepositSettings CategoryDepositSetting[]
  branchPricingDefaults   BranchPricingDefaults[]
  gstRule                 GSTRule?
  featureFlags            BranchFeatureFlag[]
  captureConfigs          VehiclePhotoCaptureConfig[]
  auditLogs               AuditLog[]
  staffActivityLogs       StaffActivityLog[]
  durationDiscountSlabs   DurationDiscountSlab[]
  discountConfig          BranchDiscountConfig?
  paymentConfig           BranchPaymentConfig?
  paymentTransactions     PaymentTransaction[]
  cashShifts              CashShift[]
  refundRequests          RefundRequest[]
  createdAt               DateTime                    @default(now())
  deletedAt               DateTime?
}

enum StaffActionType {
  CREATED
  APPROVED
  REJECTED
  CANCELLED
  CONFIRMED
  UPDATED
  DELETED
  UPLOADED
  SWAPPED
  REFUNDED
  ASSESSED
  INITIATED
  COMPLETED
  APPLIED
  OVERRIDDEN
  RECALCULATED
  FLAGGED
  COLLECTED
  RECONCILED
  SETTLED
  DISBURSED
}

enum StaffEntityType {
  BOOKING
  INVOICE
  PAYMENT
  CUSTOMER
  VEHICLE
  KYC
  DAMAGE_REPORT
  DEPOSIT
  EMPLOYEE
  PRICING
  CAPTURE_CONFIG
  DISCOUNT_RULE
  DISCOUNT_APPLICATION
  MANUAL_DISCOUNT
  PAYMENT_TRANSACTION
  CASH_SHIFT
  REFUND_REQUEST
}

// ── Payment Management Enums ──────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  ONLINE
  SPLIT
}

enum PaymentTransactionStatus {
  INITIATED
  COLLECTED
  CONFIRMED
  FAILED
  REJECTED
  REFUNDED
}

enum PaymentPurpose {
  ADVANCE
  REMAINING_BALANCE
  FULL_PAYMENT
  EXTENSION
  DAMAGE_FEE
  SAFETY_DEPOSIT
  OVERPAYMENT_REFUND
  CANCELLATION_REFUND
}

enum RefundStatus {
  PENDING_APPROVAL
  APPROVED
  COMPLETED
  REJECTED
}

enum CashShiftStatus {
  OPEN
  CLOSED
  DISCREPANCY_FLAGGED
}

model StaffActivityLog {
  id       Int    @id @default(autoincrement())
  publicId String @unique

  // Actor (de-normalised — no join needed for reads)
  actorPublicId String
  actorName     String
  actorRole     Role

  // Branch (de-normalised)
  branchId   Int
  branchName String

  // Action
  actionType  StaffActionType
  entityType  StaffEntityType
  entityRef   String
  description String

  // Extra structured data
  metadata Json?

  // UTC
  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([actorPublicId])
  @@index([actionType])
  @@index([entityType])
  @@index([createdAt])
}

model BranchPricingSetting {
  id             Int     @id @default(autoincrement())
  branchId       Int     @unique
  weekendEnabled Boolean @default(true)
  peakEnabled    Boolean @default(false)
  customEnabled  Boolean @default(false)

  weekendMultiplier Decimal @default(1.2)
  peakMultiplier    Decimal @default(1.5)
  customMultiplier  Decimal @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
}

// VEHICLES

model VehicleCategory {
  id          Int     @id @default(autoincrement())
  publicId    String  @unique
  name        String
  description String?
  rank        Int     @default(1)

  pricingDiscountSlabs    PricingDiscountSlab[]
  categoryDepositSettings CategoryDepositSetting[]
  vehicles                Vehicle[]
  pricingRules            PricingRule[]
  branchPricingDefaults   BranchPricingDefaults[]
  captureConfigs          VehiclePhotoCaptureConfig[]
}

// VEHICLE PHOTO CAPTURE CONFIG
// Branch managers configure which sides/angles to capture per vehicle category.
model VehiclePhotoCaptureConfig {
  id         Int    @id @default(autoincrement())
  publicId   String @unique
  branchId   Int
  categoryId Int
  fields     Json // [{ name: string, required: boolean }]

  branch    Branch          @relation(fields: [branchId], references: [id])
  category  VehicleCategory @relation(fields: [categoryId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([branchId, categoryId])
  @@index([branchId])
}

model Vehicle {
  id               Int                        @id @default(autoincrement())
  publicId         String                     @unique
  branchId         Int
  categoryId       Int
  make             String
  model            String
  regNo            String                     @unique
  odo              Int
  fuelLevel        Int                        @default(0)
  advancePayAmount Decimal                    @default(0)
  insuranceExpiry  DateTime
  status           VehicleStatus              @default(AVAILABLE)
  branch           Branch                     @relation(fields: [branchId], references: [id])
  category         VehicleCategory            @relation(fields: [categoryId], references: [id])
  insuranceRecords VehicleInsurance[]
  maintenance      VehicleMaintenanceRecord[]
  damageReports    DamageReport[]
  pricingOverride  VehiclePricingOverride?
  customPricing    VehicleCustomPricing?
  images           VehicleImage[]
  bookingItems     BookingItem[]
  featureFlags     VehicleFeatureFlag[]
  swapsAsOriginal  VehicleSwap[]              @relation("OriginalVehicle")
  swapsAsNew       VehicleSwap[]              @relation("NewVehicle")
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  deletedAt        DateTime?

  @@index([branchId])
  @@index([categoryId])
  @@index([status])
  // Performance indexes
  @@index([status, deletedAt, insuranceExpiry])
  @@index([make, model])
  @@index([branchId, categoryId, status])
}

model VehiclePricingOverride {
  id          Int      @id @default(autoincrement())
  vehicleId   Int      @unique
  customPrice Decimal?
  multiplier  Decimal?
  enabled     Boolean  @default(false)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

model VehicleCustomPricing {
  id            Int      @id @default(autoincrement())
  publicId      String   @unique
  vehicleId     Int      @unique
  hourlyRate    Decimal?
  price12Hour   Decimal?
  freeKm12Hour  Int      @default(100)
  price24Hour   Decimal
  freeKm24Hour  Int      @default(150)
  priceMonthly  Decimal?
  freeKmMonthly Int      @default(1500)
  extraKmRate   Decimal  @default(8.00)
  extraHourRate Decimal  @default(100.00)
  enabled       Boolean  @default(true)

  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([enabled])
}

model BranchPricingDefaults {
  id            Int      @id @default(autoincrement())
  publicId      String   @unique
  branchId      Int
  categoryId    Int
  hourlyRate    Decimal?
  price12Hour   Decimal?
  freeKm12Hour  Int      @default(100)
  price24Hour   Decimal
  freeKm24Hour  Int      @default(150)
  priceMonthly  Decimal?
  freeKmMonthly Int      @default(1500)
  extraKmRate   Decimal  @default(8.00)
  extraHourRate Decimal  @default(100.00)

  branch    Branch          @relation(fields: [branchId], references: [id])
  category  VehicleCategory @relation(fields: [categoryId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([branchId, categoryId])
  @@index([branchId])
  @@index([categoryId])
}

model VehicleInsurance {
  id           Int      @id @default(autoincrement())
  publicId     String   @unique
  vehicleId    Int
  policyNumber String
  provider     String
  validTill    DateTime

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

model VehicleMaintenanceRecord {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique
  vehicleId   Int
  description String
  cost        Decimal
  servicedAt  DateTime

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

model VehicleImage {
  id          Int     @id @default(autoincrement())
  publicId    String  @unique
  vehicleId   Int
  fileId      Int
  isThumbnail Boolean @default(false)

  vehicle Vehicle    @relation(fields: [vehicleId], references: [id])
  file    FileObject @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([fileId])
  // Performance index
  @@index([vehicleId, isThumbnail])
}

// BOOKINGS

model PricingRule {
  id         Int             @id @default(autoincrement())
  publicId   String          @unique
  ruleType   PricingRuleType
  multiplier Decimal
  categoryId Int?

  category  VehicleCategory? @relation(fields: [categoryId], references: [id])
  createdAt DateTime         @default(now())
}

model PricingDiscountSlab {
  id         Int     @id @default(autoincrement())
  days       Int
  multiplier Decimal
  branchId   Int?
  categoryId Int?

  branch   Branch?          @relation(fields: [branchId], references: [id])
  category VehicleCategory? @relation(fields: [categoryId], references: [id])
}

model CategoryDepositSetting {
  id         Int     @id @default(autoincrement())
  branchId   Int
  categoryId Int
  amount     Decimal

  branch   Branch          @relation(fields: [branchId], references: [id])
  category VehicleCategory @relation(fields: [categoryId], references: [id])

  @@unique([branchId, categoryId])
}

model Booking {
  id               Int               @id @default(autoincrement())
  publicId         String            @unique
  customerId       Int
  branchId         Int
  startAt          DateTime
  endAt            DateTime
  days             Int
  rentalPeriodType RentalPeriodType?
  actualHours      Decimal?
  billableHours    Decimal?
  startOdometer    Int?
  endOdometer      Int?
  totalKmDriven    Int?
  freeKmLimit      Int?
  extraKmCharged   Int?
  holdExpiresAt    DateTime?
  totalBase        Decimal
  totalDiscount    Decimal
  totalDeposit     Decimal
  totalTax         Decimal           @default(0)
  totalFinal       Decimal
  status           BookingStatus     @default(HOLD)
  transactionId    String?           @unique
  paymentStatus    PaymentStatus     @default(CREATED)
  pricingSnapshot  Json
  createdById      Int
  depositMethod    DepositMethod?
  kycFileId        Int?
  kycFile          FileObject?       @relation("BookingKyc", fields: [kycFileId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  branch           Branch            @relation(fields: [branchId], references: [id])
  createdBy        User              @relation("BookingCreator", fields: [createdById], references: [id])

  photos              BookingPhoto[]
  damages             DamageReport[]
  items               BookingItem[]
  deposit             Deposit?
  invoice             Invoice?
  cancellationInvoice CancellationInvoice?
  vehicleSwaps        VehicleSwap[]

  // Advance Payment Tracking
  isAdvancePayment   Boolean        @default(false)
  advanceAmount      Decimal        @default(0)
  advancePaidAt      DateTime?
  advancePaymentId   String?
  advancePaymentMode DepositMethod?

  // Remaining Balance (after advance is collected)
  remainingBalance     Decimal        @default(0)
  remainingPaidAt      DateTime?
  remainingPaymentId   String?        @unique
  remainingPaymentMode DepositMethod?
  remainingPaidDuring  String? // "PICKUP" | "RETURN"

  // Safety Deposit Tracking
  safetyDeposit           Decimal        @default(0)
  safetyDepositPaidAt     DateTime?
  safetyDepositMethod     DepositMethod?
  safetyDepositRefunded   Boolean        @default(false)
  safetyDepositRefundedAt DateTime?
  safetyDepositSetOff     Boolean        @default(false)

  // Cancellation Tracking
  cancelledAt        DateTime?
  cancellationReason String?

  // Manager Confirmation Flag
  requiresManagerConfirmation Boolean @default(false)

  // Discount Tracking
  couponCode          String?
  discountRuleId      Int?
  discountRule        DiscountRule?        @relation(fields: [discountRuleId], references: [id])
  discountApplication DiscountApplication?
  manualDiscount      ManualDiscount?

  // Payment Tracking
  paymentTransactions PaymentTransaction[]
  refundRequests      RefundRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([branchId])
  @@index([createdById])
  @@index([status])
  @@index([startAt, endAt])
  @@index([advancePaymentId])
  @@index([remainingPaymentId])
  @@index([cancelledAt])
  // Performance index
  @@index([status, startAt, endAt])
  @@index([rentalPeriodType])
  @@index([discountRuleId])
  @@index([couponCode])
}

model BookingItem {
  id        Int @id @default(autoincrement())
  bookingId Int
  vehicleId Int

  days            Int
  baseTotal       Decimal
  discountAmount  Decimal
  discountPercent Decimal
  deposit         Decimal
  taxAmount       Decimal @default(0)
  cgstAmount      Decimal @default(0)
  sgstAmount      Decimal @default(0)
  taxRate         Decimal @default(0)
  finalTotal      Decimal

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([vehicleId])
  // Performance index
  @@index([vehicleId, bookingId])
}

model BookingPhoto {
  id             Int              @id @default(autoincrement())
  publicId       String           @unique
  bookingId      Int
  fileId         Int
  type           BookingPhotoType
  captureLabel   String? // e.g. "Front", "Left Side" — set when uploaded via capture config
  damageReportId Int?

  booking      Booking       @relation(fields: [bookingId], references: [id])
  file         FileObject    @relation(fields: [fileId], references: [id])
  createdAt    DateTime      @default(now())
  damageReport DamageReport? @relation(fields: [damageReportId], references: [id])

  @@index([bookingId])
  @@index([fileId])
}

model DamageReport {
  id            Int                       @id @default(autoincrement())
  publicId      String                    @unique
  bookingId     Int
  vehicleId     Int
  severity      String
  estimatedCost Decimal
  finalCost     Decimal?
  notes         Json
  approvedById  Int?
  chargeType    DamageChargeType          @default(PENALTY)
  status        DamageReportStatus        @default(PENDING)
  disposition   VehicleReturnDisposition?
  booking       Booking                   @relation(fields: [bookingId], references: [id])
  vehicle       Vehicle                   @relation(fields: [vehicleId], references: [id])
  approvedBy    User?                     @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  photos        BookingPhoto[]

  createdAt DateTime @default(now())
}

// DEPOSIT & PAYMENTS

model Deposit {
  id           Int           @id @default(autoincrement())
  publicId     String        @unique
  bookingId    Int           @unique
  amount       Decimal
  method       DepositMethod
  isRefunded   Boolean       @default(false)
  refundedAt   DateTime?
  refundMethod String?

  booking   Booking  @relation(fields: [bookingId], references: [id])
  createdAt DateTime @default(now())
}

model Payment {
  id                Int           @id @default(autoincrement())
  publicId          String        @unique
  invoiceId         Int
  method            DepositMethod // ONLINE_RAZORPAY or CASH/UPI
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            PaymentStatus
  amount            Decimal

  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
}

model PaymentWebhookLog {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique
  payload   Json
  signature String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

// INVOICE

model Invoice {
  id            Int           @id @default(autoincrement())
  publicId      String        @unique
  bookingId     Int           @unique
  subtotal      Decimal
  discount      Decimal
  tax           Decimal
  damageCharges Decimal
  total         Decimal
  status        InvoiceStatus @default(PENDING)

  // PDF Generation Fields
  invoiceNumber    String?     @unique
  invoicePdfFileId Int?
  invoicePdfFile   FileObject? @relation("InvoicePdf", fields: [invoicePdfFileId], references: [id], onDelete: SetNull)
  generatedAt      DateTime?

  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items     InvoiceItem[]
  payments  Payment[]
  createdAt DateTime      @default(now())

  @@index([bookingId])
  @@index([invoicePdfFileId])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  publicId  String  @unique
  invoiceId Int
  label     String
  amount    Decimal

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

// AUDIT LOG

enum AuditCategory {
  BOOKING
  PAYMENT
  VEHICLE
  CUSTOMER
  EMPLOYEE
  BRANCH
  AUTH
  SYSTEM
  DISCOUNT
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

model AuditLog {
  id       Int    @id @default(autoincrement())
  publicId String @unique

  // Identity & Actor
  actorId       Int?
  actorName     String @default("")
  actorRole     Role   @default(CUSTOMER)
  actorBranchId Int?

  // Approver (staff who processed a customer-initiated action)
  approverId   Int?
  approverName String?
  approverRole Role?

  // Action Details
  action      String
  category    AuditCategory @default(SYSTEM)
  severity    AuditSeverity @default(INFO)
  description String        @default("")

  // Entity
  entity      String
  entityId    String
  entityLabel String?

  // Context
  ipAddress String?
  userAgent String?
  requestId String?

  // Data Changes
  before        Json?
  after         Json?
  changedFields String[]

  // Domain-specific extra data
  metadata Json?

  // Timestamps (UTC)
  createdAt DateTime @default(now())

  actor       User?   @relation("ActorAuditLogs", fields: [actorId], references: [id])
  approver    User?   @relation("ApproverAuditLogs", fields: [approverId], references: [id])
  actorBranch Branch? @relation(fields: [actorBranchId], references: [id])
}

// SYSTEM SETTINGS

model SystemSetting {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model GSTRule {
  id        Int     @id @default(autoincrement())
  publicId  String  @unique
  branchId  Int     @unique
  gstNumber String
  cgstRate  Decimal @default(9.00)
  sgstRate  Decimal @default(9.00)
  igstRate  Decimal @default(0.00)

  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimezoneSetting {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique
  timezone  String   @default("Asia/Kolkata")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timezone])
}

model CancellationInvoice {
  id         Int    @id @default(autoincrement())
  publicId   String @unique
  bookingId  Int    @unique
  customerId Int

  advanceAmount   Decimal
  cancellationFee Decimal
  reason          String?
  notes           String?

  invoiceNumber    String?   @unique
  invoicePdfFileId Int?
  generatedAt      DateTime?
  sentToCustomer   Boolean   @default(false)
  sentAt           DateTime?

  booking        Booking     @relation(fields: [bookingId], references: [id])
  customer       Customer    @relation(fields: [customerId], references: [id])
  invoicePdfFile FileObject? @relation("CancellationInvoicePdf", fields: [invoicePdfFileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([customerId])
  @@index([invoiceNumber])
}

// FEATURE FLAGS

enum FeatureFlagScope {
  SYSTEM
  BRANCH
  VEHICLE
}

model FeatureFlag {
  id          Int              @id @default(autoincrement())
  publicId    String           @unique
  key         String           @unique
  name        String
  description String?
  scope       FeatureFlagScope
  enabled     Boolean          @default(false)
  config      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchFlags  BranchFeatureFlag[]
  vehicleFlags VehicleFeatureFlag[]

  @@index([key])
  @@index([scope])
  @@index([enabled])
}

model BranchFeatureFlag {
  id       Int     @id @default(autoincrement())
  branchId Int
  flagId   Int
  enabled  Boolean @default(false)
  config   Json?

  branch Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  flag   FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, flagId])
  @@index([branchId])
  @@index([flagId])
  @@index([enabled])
}

model VehicleFeatureFlag {
  id        Int     @id @default(autoincrement())
  vehicleId Int
  flagId    Int
  enabled   Boolean @default(false)
  config    Json?

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  flag    FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, flagId])
  @@index([vehicleId])
  @@index([flagId])
  @@index([enabled])
}

model VehicleSwap {
  id                    Int            @id @default(autoincrement())
  publicId              String         @unique
  bookingId             Int
  originalVehicleId     Int
  newVehicleId          Int
  swappedById           Int
  reason                SwapReason
  reasonNotes           String?
  originalVehicleStatus VehicleStatus?
  originalVehicleNotes  String?
  swappedAt             DateTime       @default(now())

  booking         Booking @relation(fields: [bookingId], references: [id])
  originalVehicle Vehicle @relation("OriginalVehicle", fields: [originalVehicleId], references: [id])
  newVehicle      Vehicle @relation("NewVehicle", fields: [newVehicleId], references: [id])
  swappedBy       User    @relation(fields: [swappedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([originalVehicleId])
  @@index([newVehicleId])
  @@index([swappedById])
  @@index([swappedAt])
  @@index([reason])
}

// ─── DISCOUNT SYSTEM ────────────────────────────────────────────────────────

enum DiscountScope {
  GLOBAL
  BRANCH
  USER
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum AdjustmentType {
  NONE
  PENDING_REFUND
  REFUNDED
  WALLET_CREDITED
  CASH_HANDLED
}

enum ManualDiscountStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// Coupon / promo rule definitions. Each row is one discount rule that can be
// referenced by a coupon code or applied automatically via scope logic.
model DiscountRule {
  id       Int    @id @default(autoincrement())
  publicId String @unique

  code        String  @unique
  name        String
  description String?

  // Type & value
  discountType   DiscountType
  value          Decimal      @db.Decimal(10, 4)
  maxDiscountCap Decimal?     @db.Decimal(10, 2)

  // Scope — GLOBAL applies everywhere; BRANCH restricts to applicableBranchIds;
  // USER restricts to targetCustomerIds.
  scope               DiscountScope @default(GLOBAL)
  applicableBranchIds Int[]
  targetCustomerIds   Int[]

  // Customer eligibility
  newCustomersOnly Boolean @default(false)
  minBookingCount  Int?
  maxBookingCount  Int?

  // Booking constraints
  minBookingAmount             Decimal? @db.Decimal(10, 2)
  maxBookingAmount             Decimal? @db.Decimal(10, 2)
  applicableVehicleCategoryIds Int[]
  minRentalDays                Int?
  maxRentalDays                Int?

  // Payment plan constraints — e.g. ["FULL"], ["ADVANCE"], ["FULL","ADVANCE"]
  applicablePaymentPlans  String[]
  allowPartialPayment     Boolean  @default(true)
  minAdvanceAfterDiscount Decimal? @db.Decimal(10, 2)
  allowPostBooking        Boolean  @default(false)
  allowPostInvoice        Boolean  @default(false)

  // Usage limits
  totalUsageLimit Int?
  perUserLimit    Int?
  perBranchLimit  Int?
  perDayLimit     Int?

  // Stacking & priority
  stackable Boolean @default(false)
  priority  Int     @default(0)

  // Validity window
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  // Audit
  createdById Int
  createdBy   User @relation("DiscountRuleCreator", fields: [createdById], references: [id])

  // Relations
  usageLogs    CouponUsageLog[]
  bookings     Booking[]
  applications DiscountApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive, startDate, endDate])
  @@index([scope])
  @@index([createdById])
}

// Per-branch rental-duration-based discount slabs. Replaces PricingDiscountSlab
// with an explicit discountType + value instead of a multiplier.
model DurationDiscountSlab {
  id           Int          @id @default(autoincrement())
  branchId     Int
  minDays      Int
  maxDays      Int? // null = open-ended upper bound
  discountType DiscountType
  value        Decimal      @db.Decimal(10, 4)
  label        String? // e.g. "Weekly", "Bi-weekly"

  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, minDays])
}

// Branch-level discount system configuration. One row per branch (upserted).
model BranchDiscountConfig {
  id                                  Int      @id @default(autoincrement())
  branchId                            Int      @unique
  durationDiscountEnabled             Boolean  @default(false)
  stackWithCoupon                     Boolean  @default(false)
  maxCombinedDiscountPercent          Decimal? @db.Decimal(5, 2)
  // If manual discount amount >= managerApprovalThreshold, requiresApproval = true
  managerApprovalThreshold            Decimal  @default(500) @db.Decimal(10, 2)
  maxManualDiscountsPerEmployeePerDay Int      @default(5)

  // ── Manager coupon creation guardrails (set by ADMIN only) ─────────────────
  // Master switch — admin enables per branch; defaults to OFF
  managerCouponCreationEnabled    Boolean @default(false)
  // Maximum discount % a manager coupon can offer (enforced server-side)
  maxManagerCouponDiscountPercent Decimal @default(15) @db.Decimal(5, 2)
  // Maximum flat discount ₹ a manager coupon can offer
  maxManagerCouponFlatAmount      Decimal @default(500) @db.Decimal(10, 2)
  // Maximum validity window in days from creation date
  maxManagerCouponValidityDays    Int     @default(7)
  // Maximum total uses allowed per manager-generated coupon
  maxManagerCouponUsageLimit      Int     @default(5)
  // How many coupons one manager can create per day
  maxManagerCouponsPerDay         Int     @default(3)

  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Immutable record of every discount applied to a booking. Created once, never
// updated or deleted.
model DiscountApplication {
  id        Int    @id @default(autoincrement())
  publicId  String @unique
  bookingId Int    @unique

  // Base amount before any discount
  originalAmount Decimal @db.Decimal(10, 2)

  // Layer 1 — duration-based discount
  durationDiscountAmount  Decimal @default(0) @db.Decimal(10, 2)
  durationDiscountPercent Decimal @default(0) @db.Decimal(10, 4)
  durationSlabId          Int?

  // Layer 2 — coupon discount
  couponDiscountAmount  Decimal @default(0) @db.Decimal(10, 2)
  couponDiscountPercent Decimal @default(0) @db.Decimal(10, 4)
  discountRuleId        Int?

  // Layer 3 — manual override
  manualDiscountAmount Decimal @default(0) @db.Decimal(10, 2)
  manualDiscountId     Int?    @unique

  // Totals
  totalDiscountAmount Decimal @db.Decimal(10, 2)
  finalAmount         Decimal @db.Decimal(10, 2)

  // Context
  paymentPlan    String // "FULL" | "ADVANCE"
  adjustmentType AdjustmentType @default(NONE)

  // Relations
  booking        Booking         @relation(fields: [bookingId], references: [id])
  discountRule   DiscountRule?   @relation(fields: [discountRuleId], references: [id])
  manualDiscount ManualDiscount? @relation(fields: [manualDiscountId], references: [id])

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([discountRuleId])
}

// Append-only log — one row per coupon redemption. Used for usage-limit checks.
model CouponUsageLog {
  id               Int      @id @default(autoincrement())
  discountRuleId   Int
  bookingId        Int
  customerId       Int
  branchId         Int
  discountedAmount Decimal  @db.Decimal(10, 2)
  appliedAt        DateTime @default(now())

  discountRule DiscountRule @relation(fields: [discountRuleId], references: [id])

  @@index([discountRuleId, customerId])
  @@index([discountRuleId, branchId, appliedAt])
  @@index([customerId, appliedAt])
}

// Manager-issued manual discount override for a booking.
model ManualDiscount {
  id        Int     @id @default(autoincrement())
  publicId  String  @unique
  bookingId Int     @unique
  amount    Decimal @db.Decimal(10, 2)
  reason    String

  issuedById   Int
  approvedById Int?

  status           ManualDiscountStatus @default(PENDING_APPROVAL)
  requiresApproval Boolean              @default(false)

  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  issuedBy    User                 @relation("ManualDiscountIssuer", fields: [issuedById], references: [id])
  approvedBy  User?                @relation("ManualDiscountApprover", fields: [approvedById], references: [id])
  booking     Booking              @relation(fields: [bookingId], references: [id])
  application DiscountApplication?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issuedById, createdAt])
  @@index([bookingId])
  @@index([status])
}

// ── Cash & Payment Management ────────────────────────────────────────────────

// Per-branch payment system configuration. Controls whether cash confirmation,
// shift tracking, split payments, and refund approval workflows are enabled.
model BranchPaymentConfig {
  id       Int @id @default(autoincrement())
  branchId Int @unique

  // Cash control — false = simple mode (all cash auto-confirmed)
  cashConfirmationEnabled        Boolean  @default(false)
  // When cashConfirmationEnabled=true: block PICKED_UP until cash CONFIRMED
  blockProgressionUntilConfirmed Boolean  @default(true)
  // Optional per-employee cash limit (INR). null = no limit
  maxCashPerEmployee             Decimal? @db.Decimal(10, 2)
  // Require employee to close shift before logging out
  requireShiftSettlement         Boolean  @default(false)
  // Allow SPLIT method (cash + online in one transaction)
  splitPaymentEnabled            Boolean  @default(false)
  // Allow settling bookings from other branches (future use)
  crossBranchSettlementEnabled   Boolean  @default(false)
  // Cash refunds require manager approval before payout
  refundApprovalRequired         Boolean  @default(true)
  // Allow online refunds to be processed through this branch
  onlineRefundEnabled            Boolean  @default(true)
  // Hours after which a COLLECTED (unconfirmed) cash triggers a fraud alert
  delayedCashAlertHours          Int      @default(2)

  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single financial transaction attached to a booking. Append-only — never
// updated directly; state transitions occur via dedicated service methods.
model PaymentTransaction {
  id             Int                      @id @default(autoincrement())
  publicId       String                   @unique
  // Caller-supplied unique key to prevent duplicate submissions on retry
  idempotencyKey String                   @unique
  bookingId      Int
  branchId       Int
  purpose        PaymentPurpose
  method         PaymentMethod
  status         PaymentTransactionStatus @default(INITIATED)

  // Amounts (totalAmount = cashAmount + onlineAmount)
  totalAmount  Decimal @db.Decimal(10, 2)
  cashAmount   Decimal @default(0) @db.Decimal(10, 2)
  onlineAmount Decimal @default(0) @db.Decimal(10, 2)

  // Online payment metadata
  onlineTransactionRef String?
  onlineGateway        String?

  // Cash collection actor (employee)
  collectedById Int?
  collectedAt   DateTime?

  // Cash confirmation actor (manager)
  confirmedById Int?
  confirmedAt   DateTime?

  // Rejection
  rejectedById    Int?
  rejectedAt      DateTime?
  rejectionReason String?

  // Optional shift linkage
  cashShiftId Int?

  notes String?

  booking     Booking    @relation(fields: [bookingId], references: [id])
  branch      Branch     @relation(fields: [branchId], references: [id])
  collectedBy User?      @relation("PaymentCollector", fields: [collectedById], references: [id])
  confirmedBy User?      @relation("PaymentConfirmer", fields: [confirmedById], references: [id])
  rejectedBy  User?      @relation("PaymentRejector", fields: [rejectedById], references: [id])
  cashShift   CashShift? @relation(fields: [cashShiftId], references: [id])

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([branchId, status])
  @@index([collectedById, collectedAt])
  @@index([cashShiftId])
  @@index([purpose])
  @@index([status, createdAt])
}

// Refund request lifecycle. Cash refunds require manager approval before payout.
model RefundRequest {
  id        Int           @id @default(autoincrement())
  publicId  String        @unique
  bookingId Int
  branchId  Int
  amount    Decimal       @db.Decimal(10, 2)
  reason    String
  method    PaymentMethod
  status    RefundStatus  @default(PENDING_APPROVAL)

  requestedById        Int
  approvedById         Int?
  approvedAt           DateTime?
  completedById        Int?
  completedAt          DateTime?
  onlineTransactionRef String?
  rejectionReason      String?
  rejectedAt           DateTime?

  booking     Booking @relation(fields: [bookingId], references: [id])
  branch      Branch  @relation(fields: [branchId], references: [id])
  requestedBy User    @relation("RefundRequester", fields: [requestedById], references: [id])
  approvedBy  User?   @relation("RefundApprover", fields: [approvedById], references: [id])
  completedBy User?   @relation("RefundCompleter", fields: [completedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([branchId, status])
  @@index([requestedById])
}

// Tracks an employee's cash-handling session (shift). All cash PaymentTransactions
// collected during a shift are linked here for reconciliation.
model CashShift {
  id                     Int             @id @default(autoincrement())
  publicId               String          @unique
  employeeId             Int
  branchId               Int
  status                 CashShiftStatus @default(OPEN)
  openedAt               DateTime        @default(now())
  closedAt               DateTime?
  // Sum of all CONFIRMED cash transactions linked to this shift
  expectedTotal          Decimal         @default(0) @db.Decimal(10, 2)
  // Actual cash counted by employee at shift close
  actualTotal            Decimal         @default(0) @db.Decimal(10, 2)
  // actualTotal - expectedTotal (negative = short, positive = over)
  discrepancy            Decimal         @default(0) @db.Decimal(10, 2)
  discrepancyExplanation String?
  reconciledById         Int?
  reconciledAt           DateTime?

  employee     User                 @relation("ShiftEmployee", fields: [employeeId], references: [id])
  branch       Branch               @relation(fields: [branchId], references: [id])
  reconciledBy User?                @relation("ShiftReconciler", fields: [reconciledById], references: [id])
  transactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([branchId, status])
  @@index([openedAt])
}
