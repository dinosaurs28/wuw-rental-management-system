  vehicleId Int
  flagId    Int
  enabled   Boolean @default(false)
  config    Json?

  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  flag    FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, flagId])
  @@index([vehicleId])
  @@index([flagId])
  @@index([enabled])
}

model VehicleSwap {
  id                     Int            @id @default(autoincrement())
  publicId               String         @unique
  bookingId              Int
  originalVehicleId      Int
  newVehicleId           Int
  swappedById            Int
  reason                 SwapReason
  reasonNotes            String?
  originalVehicleStatus  VehicleStatus?
  originalVehicleNotes   String?
  swappedAt              DateTime       @default(now())

  booking                Booking        @relation(fields: [bookingId], references: [id])
  originalVehicle        Vehicle        @relation("OriginalVehicle", fields: [originalVehicleId], references: [id])
  newVehicle             Vehicle        @relation("NewVehicle", fields: [newVehicleId], references: [id])
  swappedBy              User           @relation(fields: [swappedById], references: [id])

  extension              BookingExtension?

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([bookingId])
  @@index([originalVehicleId])
  @@index([newVehicleId])
  @@index([swappedById])
  @@index([swappedAt])
  @@index([reason])
}

// ─── DISCOUNT SYSTEM ────────────────────────────────────────────────────────

enum DiscountScope {
  GLOBAL
  BRANCH
  USER
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum AdjustmentType {
  NONE
  PENDING_REFUND
  REFUNDED
  WALLET_CREDITED
  CASH_HANDLED
}

enum ManualDiscountStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// Coupon / promo rule definitions. Each row is one discount rule that can be
// referenced by a coupon code or applied automatically via scope logic.
model DiscountRule {
  id          Int           @id @default(autoincrement())
  publicId    String        @unique

  code        String        @unique
  name        String
  description String?

  // Type & value
  discountType   DiscountType
  value          Decimal      @db.Decimal(10, 4)
  maxDiscountCap Decimal?     @db.Decimal(10, 2)

  // Scope — GLOBAL applies everywhere; BRANCH restricts to applicableBranchIds;
  // USER restricts to targetCustomerIds.
  scope                DiscountScope @default(GLOBAL)
  applicableBranchIds  Int[]
  targetCustomerIds    Int[]

  // Customer eligibility
  newCustomersOnly Boolean @default(false)
  minBookingCount  Int?
  maxBookingCount  Int?

  // Booking constraints
  minBookingAmount             Decimal? @db.Decimal(10, 2)
  maxBookingAmount             Decimal? @db.Decimal(10, 2)
  applicableVehicleCategoryIds Int[]
  minRentalDays                Int?
  maxRentalDays                Int?

  // Payment plan constraints — e.g. ["FULL"], ["ADVANCE"], ["FULL","ADVANCE"]
  applicablePaymentPlans  String[]
  allowPartialPayment     Boolean  @default(true)
  minAdvanceAfterDiscount Decimal? @db.Decimal(10, 2)
  allowPostBooking        Boolean  @default(false)
  allowPostInvoice        Boolean  @default(false)

  // Usage limits
  totalUsageLimit Int?
  perUserLimit    Int?
  perBranchLimit  Int?
  perDayLimit     Int?

  // Stacking & priority
  stackable Boolean @default(false)
  priority  Int     @default(0)

  // Validity window
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  // Audit
  createdById Int
  createdBy   User   @relation("DiscountRuleCreator", fields: [createdById], references: [id])

  // Relations
  usageLogs    CouponUsageLog[]
  bookings     Booking[]
  applications DiscountApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive, startDate, endDate])
  @@index([scope])
  @@index([createdById])
}

// Per-branch rental-duration-based discount slabs. Replaces PricingDiscountSlab
// with an explicit discountType + value instead of a multiplier.
model DurationDiscountSlab {
  id           Int          @id @default(autoincrement())
  branchId     Int
  minDays      Int
  maxDays      Int?         // null = open-ended upper bound
  discountType DiscountType
  value        Decimal      @db.Decimal(10, 4)
  label        String?      // e.g. "Weekly", "Bi-weekly"

  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, minDays])
}

// Branch-level discount system configuration. One row per branch (upserted).
model BranchDiscountConfig {
  id                              Int      @id @default(autoincrement())
  branchId                        Int      @unique
  durationDiscountEnabled         Boolean  @default(false)
  stackWithCoupon                 Boolean  @default(false)
  maxCombinedDiscountPercent      Decimal? @db.Decimal(5, 2)
  // If manual discount amount >= managerApprovalThreshold, requiresApproval = true
  managerApprovalThreshold        Decimal  @default(500)  @db.Decimal(10, 2)
  maxManualDiscountsPerEmployeePerDay Int  @default(5)

  // ── Manager coupon creation guardrails (set by ADMIN only) ─────────────────
  // Master switch — admin enables per branch; defaults to OFF
  managerCouponCreationEnabled      Boolean @default(false)
  // Maximum discount % a manager coupon can offer (enforced server-side)
  maxManagerCouponDiscountPercent   Decimal @default(15)  @db.Decimal(5, 2)
  // Maximum flat discount ₹ a manager coupon can offer
  maxManagerCouponFlatAmount        Decimal @default(500) @db.Decimal(10, 2)
  // Maximum validity window in days from creation date
  maxManagerCouponValidityDays      Int     @default(7)
  // Maximum total uses allowed per manager-generated coupon
  maxManagerCouponUsageLimit        Int     @default(5)
  // How many coupons one manager can create per day
  maxManagerCouponsPerDay           Int     @default(3)

  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Immutable record of every discount applied to a booking. Created once, never
// updated or deleted.
model DiscountApplication {
  id       Int    @id @default(autoincrement())
  publicId String @unique
  bookingId Int   @unique

  // Base amount before any discount
  originalAmount Decimal @db.Decimal(10, 2)

  // Layer 1 — duration-based discount
  durationDiscountAmount  Decimal @default(0) @db.Decimal(10, 2)
  durationDiscountPercent Decimal @default(0) @db.Decimal(10, 4)
  durationSlabId          Int?

  // Layer 2 — coupon discount
  couponDiscountAmount  Decimal @default(0) @db.Decimal(10, 2)
  couponDiscountPercent Decimal @default(0) @db.Decimal(10, 4)
  discountRuleId        Int?

  // Layer 3 — manual override
  manualDiscountAmount Decimal @default(0) @db.Decimal(10, 2)
  manualDiscountId     Int?    @unique

  // Totals
  totalDiscountAmount Decimal @db.Decimal(10, 2)
  finalAmount         Decimal @db.Decimal(10, 2)

  // Context
  paymentPlan    String         // "FULL" | "ADVANCE"
  adjustmentType AdjustmentType @default(NONE)

  // Relations
  booking      Booking       @relation(fields: [bookingId], references: [id])
  discountRule DiscountRule? @relation(fields: [discountRuleId], references: [id])
  manualDiscount ManualDiscount? @relation(fields: [manualDiscountId], references: [id])

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([discountRuleId])
}

// Append-only log — one row per coupon redemption. Used for usage-limit checks.
model CouponUsageLog {
  id             Int      @id @default(autoincrement())
  discountRuleId Int
  bookingId      Int
  customerId     Int
  branchId       Int
  discountedAmount Decimal @db.Decimal(10, 2)
  appliedAt      DateTime @default(now())

  discountRule DiscountRule @relation(fields: [discountRuleId], references: [id])

  @@index([discountRuleId, customerId])
  @@index([discountRuleId, branchId, appliedAt])
  @@index([customerId, appliedAt])
}

// Manager-issued manual discount override for a booking.
model ManualDiscount {
  id       Int    @id @default(autoincrement())
  publicId String @unique
  bookingId Int   @unique
  amount   Decimal @db.Decimal(10, 2)
  reason   String

  issuedById   Int
  approvedById Int?

  status           ManualDiscountStatus @default(PENDING_APPROVAL)
  requiresApproval Boolean              @default(false)

  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  issuedBy    User  @relation("ManualDiscountIssuer", fields: [issuedById], references: [id])
  approvedBy  User? @relation("ManualDiscountApprover", fields: [approvedById], references: [id])
  booking     Booking @relation(fields: [bookingId], references: [id])
  application DiscountApplication?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issuedById, createdAt])
  @@index([bookingId])
  @@index([status])
}

// ── Cash & Payment Management ────────────────────────────────────────────────

// Per-branch payment system configuration. Controls whether cash confirmation,
// shift tracking, split payments, and refund approval workflows are enabled.
model BranchPaymentConfig {
  id                           Int      @id @default(autoincrement())
  branchId                     Int      @unique

  // Cash control — false = simple mode (all cash auto-confirmed)
  cashConfirmationEnabled      Boolean  @default(false)
  // When cashConfirmationEnabled=true: block PICKED_UP until cash CONFIRMED
  blockProgressionUntilConfirmed Boolean @default(true)
  // Optional per-employee cash limit (INR). null = no limit
  maxCashPerEmployee           Decimal? @db.Decimal(10, 2)
  // Require employee to close shift before logging out
  requireShiftSettlement       Boolean  @default(false)
  // Allow SPLIT method (cash + online in one transaction)
  splitPaymentEnabled          Boolean  @default(false)
  // Allow settling bookings from other branches (future use)
  crossBranchSettlementEnabled Boolean  @default(false)
  // Cash refunds require manager approval before payout
  refundApprovalRequired       Boolean  @default(true)
  // Allow online refunds to be processed through this branch
  onlineRefundEnabled          Boolean  @default(true)
  // Hours after which a COLLECTED (unconfirmed) cash triggers a fraud alert
  delayedCashAlertHours        Int      @default(2)

  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single financial transaction attached to a booking. Append-only — never
// updated directly; state transitions occur via dedicated service methods.
model PaymentTransaction {
  id              Int                      @id @default(autoincrement())
  publicId        String                   @unique
  // Caller-supplied unique key to prevent duplicate submissions on retry
  idempotencyKey  String                   @unique
  bookingId       Int
  branchId        Int
  purpose         PaymentPurpose
  method          PaymentMethod
  status          PaymentTransactionStatus @default(INITIATED)

  // Amounts (totalAmount = cashAmount + onlineAmount)
  totalAmount     Decimal                  @db.Decimal(10, 2)
  cashAmount      Decimal                  @default(0) @db.Decimal(10, 2)
  onlineAmount    Decimal                  @default(0) @db.Decimal(10, 2)

  // Online payment metadata
  onlineTransactionRef String?
  onlineGateway        String?

  // Cash collection actor (employee)
  collectedById   Int?
  collectedAt     DateTime?

  // Cash confirmation actor (manager)
  confirmedById   Int?
  confirmedAt     DateTime?

  // Rejection
  rejectedById    Int?
  rejectedAt      DateTime?
  rejectionReason String?

  // Optional shift linkage
  cashShiftId     Int?

  notes           String?

  booking         Booking             @relation(fields: [bookingId], references: [id])
  branch          Branch              @relation(fields: [branchId], references: [id])
  collectedBy     User?               @relation("PaymentCollector", fields: [collectedById], references: [id])
  confirmedBy     User?               @relation("PaymentConfirmer", fields: [confirmedById], references: [id])
  rejectedBy      User?               @relation("PaymentRejector", fields: [rejectedById], references: [id])
  cashShift       CashShift?          @relation(fields: [cashShiftId], references: [id])
  extension       BookingExtension?

  createdAt       DateTime            @default(now())

  @@index([bookingId])
  @@index([branchId, status])
  @@index([collectedById, collectedAt])
  @@index([cashShiftId])
  @@index([purpose])
  @@index([status, createdAt])
}

// Refund request lifecycle. Cash refunds require manager approval before payout.
model RefundRequest {
  id                 Int          @id @default(autoincrement())
  publicId           String       @unique
  bookingId          Int
  branchId           Int
  amount             Decimal      @db.Decimal(10, 2)
  reason             String
  method             PaymentMethod
  status             RefundStatus @default(PENDING_APPROVAL)

  requestedById      Int
  approvedById       Int?
  approvedAt         DateTime?
  completedById      Int?
  completedAt        DateTime?
  onlineTransactionRef String?
  rejectionReason    String?
  rejectedAt         DateTime?

  booking            Booking      @relation(fields: [bookingId], references: [id])
  branch             Branch       @relation(fields: [branchId], references: [id])
  requestedBy        User         @relation("RefundRequester", fields: [requestedById], references: [id])
  approvedBy         User?        @relation("RefundApprover", fields: [approvedById], references: [id])
  completedBy        User?        @relation("RefundCompleter", fields: [completedById], references: [id])

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([bookingId])
  @@index([branchId, status])
  @@index([requestedById])
}

// Tracks an employee's cash-handling session (shift). All cash PaymentTransactions
// collected during a shift are linked here for reconciliation.
model CashShift {
  id                    Int             @id @default(autoincrement())
  publicId              String          @unique
  employeeId            Int
  branchId              Int
  status                CashShiftStatus @default(OPEN)
  openedAt              DateTime        @default(now())
  closedAt              DateTime?
  // Sum of all CONFIRMED cash transactions linked to this shift
  expectedTotal         Decimal         @default(0) @db.Decimal(10, 2)
  // Actual cash counted by employee at shift close
  actualTotal           Decimal         @default(0) @db.Decimal(10, 2)
  // actualTotal - expectedTotal (negative = short, positive = over)
  discrepancy           Decimal         @default(0) @db.Decimal(10, 2)
  discrepancyExplanation String?
  reconciledById        Int?
  reconciledAt          DateTime?

  employee              User            @relation("ShiftEmployee", fields: [employeeId], references: [id])
  branch                Branch          @relation(fields: [branchId], references: [id])
  reconciledBy          User?           @relation("ShiftReconciler", fields: [reconciledById], references: [id])
  transactions          PaymentTransaction[]

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([employeeId, status])
  @@index([branchId, status])
  @@index([openedAt])
}

// ── Rental Extension System ───────────────────────────────────────────────────

// Immutable record of each extension request and its outcome.
// Created on evaluate(), updated on commit() or cancel().
model BookingExtension {
  id                   Int                      @id @default(autoincrement())
  publicId             String                   @unique

  bookingId            Int
  branchId             Int
  extensionTrigger     ExtensionTrigger
  extensionStatus      ExtensionStatus          @default(PENDING_PAYMENT)

  // Date window
  oldEndAt             DateTime
  requestedEndAt       DateTime
  actualNewEndAt       DateTime?                // Set on CONFIRMED — may differ if PARTIAL

  // Pricing delta
  additionalAmount     Decimal                  @db.Decimal(10, 2)
  newTotalFinal        Decimal                  @db.Decimal(10, 2)

  // Resolution
  resolutionType       ExtensionResolutionType?
  vehicleSwapOccurred  Boolean                  @default(false)
  swappedVehicleId     Int?                     // New vehicle assigned to this booking (if SWAP_CURRENT_TO_OTHER)
  affectedBookingIds   Int[]                    // Internal IDs of future bookings displaced (if SWAP_FUTURE_BOOKING)

  // Payment linkage (PaymentTransaction with purpose=EXTENSION)
  paymentTransactionId Int?                     @unique
  // VehicleSwap linkage (for SWAP_CURRENT_TO_OTHER)
  vehicleSwapId        Int?                     @unique

  // Actor
  actorId              Int
  actorPublicId        String
  actorRole            String

  rejectionReason      String?
  notes                String?

  // Relations
  booking              Booking          @relation("BookingExtensions", fields: [bookingId], references: [id])
  branch               Branch           @relation(fields: [branchId], references: [id])
  actor                User             @relation("ExtensionActor", fields: [actorId], references: [id])
  swappedVehicle       Vehicle?         @relation("ExtensionSwappedVehicle", fields: [swappedVehicleId], references: [id])
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  vehicleSwap          VehicleSwap?     @relation(fields: [vehicleSwapId], references: [id])

  // Back-relation for Booking.activeExtension
  activeForBookings    Booking[]        @relation("ActiveExtension")

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([bookingId])
  @@index([branchId, extensionStatus])
  @@index([actorId])
  @@index([createdAt])
  @@index([extensionTrigger])
}

// ── Charge Engine ────────────────────────────────────────────────────────────

// Per-branch charge module configuration. Controls which charge modules are
// active and their sub-options. Frozen as JSON snapshot on each booking.
model BranchChargeConfig {
  id       Int    @id @default(autoincrement())
  publicId String @unique
  branchId Int    @unique

  // Module toggles
  extraKmEnabled          Boolean @default(true)
  extraTimeEnabled        Boolean @default(true)
  fuelModuleEnabled       Boolean @default(false)
  fastagModuleEnabled     Boolean @default(false)
  gracePolicyEnabled      Boolean @default(false)
  damageModuleEnabled     Boolean @default(true)

  // Grace policy sub-options (only used when gracePolicyEnabled = true)
  graceType    GraceType @default(AUTOMATIC)
  graceMinutes Int       @default(15)

  // Override config
  employeeOverrideEnabled   Boolean  @default(false)
  maxOverridePercent        Decimal? @db.Decimal(5, 2)
  overrideRequiresApproval  Boolean  @default(false)
  overrideApprovalThreshold Decimal? @db.Decimal(10, 2)

  // Safety deposit config
  safetyDepositEnabled          Boolean @default(false)
  safetyDepositRequiresApproval Boolean @default(true)

  // Payment session / ledger-based financial flow
  usePaymentSessions Boolean @default(false)

  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
}

// One record per charge type per booking. Created by the Charge Engine only.
// Both originalAmount (computed) and finalAmount (after overrides) are stored.
model ChargeEntry {
  id       Int    @id @default(autoincrement())
  publicId String @unique

  bookingId  Int
  chargeType ChargeType
  moduleKey  String     // "base", "extra_km", "extra_time", etc.
  label      String     // Human-readable label for invoice line

  originalAmount Decimal @db.Decimal(10, 2)
  finalAmount    Decimal @db.Decimal(10, 2)

  // Calculation metadata
  quantity Decimal? @db.Decimal(10, 4) // e.g. excess km, extra hours
  unitRate Decimal? @db.Decimal(10, 2) // e.g. rate per extra km

  notes       String?
  isOverridden Boolean @default(false)

  createdById Int

  booking    Booking         @relation(fields: [bookingId], references: [id])
  createdBy  User            @relation("ChargeEntryCreator", fields: [createdById], references: [id])
  override   ChargeOverride?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, moduleKey])
  @@index([bookingId])
  @@index([chargeType])
}

// Immutable record of an employee override on a ChargeEntry.
// Captures before/after amounts and mandatory justification.
model ChargeOverride {
  id       Int    @id @default(autoincrement())
  publicId String @unique

  bookingId     Int
  chargeEntryId Int @unique

  originalAmount   Decimal @db.Decimal(10, 2)
  overriddenAmount Decimal @db.Decimal(10, 2)
  waivedAmount     Decimal @db.Decimal(10, 2) // = originalAmount - overriddenAmount

  reason String // mandatory

  status   OverrideStatus @default(PENDING)
  actorId  Int
  actorRole Role

  approverId      Int?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  booking     Booking     @relation(fields: [bookingId], references: [id])
  chargeEntry ChargeEntry @relation(fields: [chargeEntryId], references: [id])
  actor       User        @relation("OverrideActor", fields: [actorId], references: [id])
  approver    User?       @relation("OverrideApprover", fields: [approverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([actorId, createdAt])
  @@index([status])
}

// Captures fuel level at pickup and return. One record per booking.
// Created at pickup; return fields populated at return time.
model FuelRecord {
  id       Int    @id @default(autoincrement())
  publicId String @unique

  bookingId Int @unique

  pickupFuelLevel  FuelLevel
  returnFuelLevel  FuelLevel?

  fuelDeficit       Boolean  @default(false)
  fuelDeficitCharge Decimal? @db.Decimal(10, 2)
  skipReason        String?  // mandatory if deficit detected but charge skipped

  capturedByPickupId Int
  capturedByReturnId Int?

  pickupAt  DateTime
  returnAt  DateTime?

  booking          Booking @relation(fields: [bookingId], references: [id])
  capturedByPickup User    @relation("FuelPickupCapture", fields: [capturedByPickupId], references: [id])
  capturedByReturn User?   @relation("FuelReturnCapture", fields: [capturedByReturnId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
}

// Safety deposit request raised by employee during pickup.
// Requires manager approval when safetyDepositRequiresApproval = true.
model SafetyDepositRequest {
  id       Int    @id @default(autoincrement())
  publicId String @unique

  bookingId Int @unique

  requestedAmount Decimal @db.Decimal(10, 2)
  reason          String

  status SafetyDepositStatus @default(PENDING_APPROVAL)

  requestedById  Int
  approvedById   Int?
  approvedAmount Decimal?  @db.Decimal(10, 2)
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectionReason String?

  booking     Booking @relation(fields: [bookingId], references: [id])
  requestedBy User    @relation("DepositRequester", fields: [requestedById], references: [id])
  approvedBy  User?   @relation("DepositApprover", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([requestedById])
}

// ── Payment Session & Ledger ──────────────────────────────────────────────────

// A PaymentSession is the single source of truth for all monetary operations
// within one flow step (PICKUP, EXTENSION, RETURN). All charges, discounts,
// deposits and payments are represented as LedgerEntry rows on this session.
// Active when Booking.activePaymentSessionId = this session's id.
model PaymentSession {
  id        Int    @id @default(autoincrement())
  publicId  String @unique

  bookingId   Int
  branchId    Int
  sessionType PaymentSessionType
  status      PaymentSessionStatus @default(OPEN)

  // Cached aggregates — recomputed on every LedgerEntry mutation.
  // These are a read cache only; the entries are always authoritative.
  taxableBase             Decimal @default(0) @db.Decimal(10, 2)
  nonTaxableBase          Decimal @default(0) @db.Decimal(10, 2)
  gstAmount               Decimal @default(0) @db.Decimal(10, 2)
  totalCharges            Decimal @default(0) @db.Decimal(10, 2)
  totalDiscounts          Decimal @default(0) @db.Decimal(10, 2)
  totalPaymentsRecorded   Decimal @default(0) @db.Decimal(10, 2)
  netPayable              Decimal @default(0) @db.Decimal(10, 2)

  // Active payment attempt identifiers
  idempotencyKey      String?
  gatewayTransactionId String?
  gatewayPaymentUrl   String?

  expiresAt   DateTime?
  completedAt DateTime?
  metadata    Json?

  // Actor who opened this session
  actorId Int

  booking Booking  @relation("BookingPaymentSessions", fields: [bookingId], references: [id])
  branch  Branch   @relation(fields: [branchId], references: [id])
  actor   User     @relation("SessionActor", fields: [actorId], references: [id])
  entries LedgerEntry[]

  // Back-relation for Booking.activePaymentSession
  activeForBookings Booking[] @relation("ActiveBookingSession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([branchId])
  @@index([status])
  @@index([sessionType, status])
}

// One financial line item within a PaymentSession. Append-only — entries are
// never updated; corrections are made by voiding and re-adding.
model LedgerEntry {
  id       Int    @id @default(autoincrement())
  publicId String @unique

  sessionId Int
  bookingId Int

  entryType      LedgerEntryType
  classification LedgerEntryClassification

  // Positive = charge; negative = credit/payment/refund
  amount     Decimal @db.Decimal(10, 2)
  baseAmount Decimal @default(0) @db.Decimal(10, 2)
  gstAmount  Decimal @default(0) @db.Decimal(10, 2)

  description String

  // Link back to the originating entity (extension, chargeEntry, etc.)
  referenceId   String?
  referenceType String?

  // Idempotency key — unique per entry; prevents duplicates on API retry
  idempotencyKey String @unique

  // Soft void
  isVoided  Boolean   @default(false)
  voidedAt  DateTime?
  voidedById Int?
  voidReason String?

  // Actor
  actorId   Int
  actorRole String

  metadata Json?

  session   PaymentSession @relation(fields: [sessionId], references: [id])
  booking   Booking        @relation(fields: [bookingId], references: [id])
  actor     User           @relation("LedgerEntryActor", fields: [actorId], references: [id])
  voidedBy  User?          @relation("LedgerEntryVoidedBy", fields: [voidedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([bookingId])
  @@index([entryType])
  @@index([isVoided])
}

enum PaymentSessionStatus {
  OPEN
  COMPUTING
  AWAITING_PAYMENT
  PAYMENT_INITIATED
  COMPLETED
  ABANDONED
}

enum PaymentSessionType {
  BOOKING
  PICKUP
  EXTENSION
  RETURN
}

enum LedgerEntryType {
  BOOKING_BASE
  EXTENSION
  DEPOSIT
  EXTRA_KM
  EXTRA_TIME
  FUEL
  FASTAG
  DAMAGE
  GRACE_ADJUSTMENT
  DISCOUNT
  PAYMENT
  REFUND
}

enum LedgerEntryClassification {
  TAXABLE
  NON_TAXABLE
  DISCOUNT
  PAYMENT
}
