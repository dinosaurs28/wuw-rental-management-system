generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum KycType {
  DL
  AADHAAR
  PAN
  STUDENT_ID
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleStatus {
  AVAILABLE
  OUT_FOR_RENTAL
  MAINTENANCE
  INACTIVE
  MANAGER_REPORTED
}

// ── Charge Engine Enums ───────────────────────────────────────────────────────

enum GraceType {
  AUTOMATIC
  MANUAL
}

enum ChargeType {
  BASE
  EXTRA_KM
  EXTRA_TIME
  FUEL_DEFICIT
  FASTAG
  DAMAGE
  GRACE_ADJUSTMENT
  SAFETY_DEPOSIT
}

enum OverrideStatus {
  PENDING
  APPROVED
  AUTO_APPROVED
  REJECTED
}

enum FuelLevel {
  EMPTY
  QUARTER
  HALF
  THREE_QUARTER
  FULL
}

enum SafetyDepositStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CHARGED
  REFUNDED
}

enum BookingStatus {
  HOLD
  CONFIRMED
  PICKED_UP
  RETURNED
  CANCELLED
  HOLD_EXPIRED
}

enum BookingPhotoType {
  PRE_DELIVERY
  POST_RETURN
  DAMAGE
}

enum DepositMethod {
  ONLINE_RAZORPAY
  CASH
  UPI
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  PENDING
  APPROVED
  FINALIZED
  PAID
}

enum PricingRuleType {
  WEEKDAY
  WEEKEND
  PEAK
  CUSTOM
}

enum VehicleReturnDisposition {
  AVAILABLE
  MAINTENANCE
  DAMAGED
}

enum DamageReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DamageChargeType {
  PENALTY
  COMPENSATION
}

enum RentalPeriodType {
  HOURLY
  HALF_DAY
  FULL_DAY
  MULTI_DAY
  MONTHLY
}

enum SwapReason {
  CUSTOMER_REQUEST
  MAINTENANCE
  UPGRADE
  DOWNGRADE
  DAMAGE
  OTHER
}

// USER & AUTH

model User {
  id              Int          @id @default(autoincrement())
  publicId        String       @unique
  name            String
  email           String       @unique
  passwordHash    String?
  phone           String       @default("")
  authProvider    AuthProvider @default(PASSWORD)
  emailVerifiedAt DateTime?
  role            Role
  branchId        Int?
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)

  emailOtps             EmailVerificationOtp[]
  providers             UserProvider[]
  customerProfile       Customer?
  actorAuditLogs        AuditLog[]     @relation("ActorAuditLogs")
  approverAuditLogs     AuditLog[]     @relation("ApproverAuditLogs")
  bookingsCreated       Booking[]              @relation("BookingCreator")
  approvedDamageReports DamageReport[]
  vehicleSwaps          VehicleSwap[]
  discountRulesCreated  DiscountRule[]         @relation("DiscountRuleCreator")
  manualDiscountsIssued ManualDiscount[]       @relation("ManualDiscountIssuer")
  manualDiscountsApproved ManualDiscount[]     @relation("ManualDiscountApprover")
  collectedPayments     PaymentTransaction[]   @relation("PaymentCollector")
  confirmedPayments     PaymentTransaction[]   @relation("PaymentConfirmer")
  rejectedPayments      PaymentTransaction[]   @relation("PaymentRejector")
  openShifts            CashShift[]            @relation("ShiftEmployee")
  reconciledShifts      CashShift[]            @relation("ShiftReconciler")
  refundRequestsMade    RefundRequest[]        @relation("RefundRequester")
  refundRequestsApproved RefundRequest[]       @relation("RefundApprover")
  refundRequestsCompleted RefundRequest[]      @relation("RefundCompleter")
  initiatedExtensions   BookingExtension[]     @relation("ExtensionActor")
  chargeEntriesCreated  ChargeEntry[]          @relation("ChargeEntryCreator")
  overridesActed        ChargeOverride[]       @relation("OverrideActor")
  overridesApproved     ChargeOverride[]       @relation("OverrideApprover")
  fuelPickupCaptures    FuelRecord[]           @relation("FuelPickupCapture")
  fuelReturnCaptures    FuelRecord[]           @relation("FuelReturnCapture")
  safetyDepositRequests SafetyDepositRequest[] @relation("DepositRequester")
  safetyDepositApprovals SafetyDepositRequest[] @relation("DepositApprover")
  paymentSessionsOpened PaymentSession[]       @relation("SessionActor")
  ledgerEntriesActed    LedgerEntry[]          @relation("LedgerEntryActor")
  ledgerEntriesVoided   LedgerEntry[]          @relation("LedgerEntryVoidedBy")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  @@index([branchId])
  @@index([role])
}

model UserProvider {
  id             Int          @id @default(autoincrement())
  publicId       String       @unique
  userId         Int
  provider       AuthProvider
  providerUserId String
  accessToken    String?
  refreshToken   String?
  user           User         @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerUserId], map: "provider_providerUserId_unique")
}

model EmailVerificationOtp {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  phone     String
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// CUSTOMER & KYC

model Customer {
  id                 Int           @id @default(autoincrement())
  publicId           String        @unique
  userId             Int           @unique
  user               User          @relation(fields: [userId], references: [id])
  alternatePhone     String?
  dob                String?
  addressLine1       String        @default("")
  city               String        @default("")
  state              String        @default("")
  country            String        @default("India")
  zipCode            String        @default("")
  isProfileCompleted Boolean       @default(false)
  kycs               CustomerKyc[]
  bookings           Booking[]

  cancellationInvoices  CancellationInvoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model CustomerKyc {
  id         Int       @id @default(autoincrement())
  publicId   String    @unique
  customerId Int
  type       KycType
  fileId     Int
  status     KycStatus @default(PENDING)

  customer Customer   @relation(fields: [customerId], references: [id])
  file     FileObject @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now())

  @@unique([customerId, type])
  @@index([customerId])
  @@index([fileId])
}

// FILE STORAGE (Cloudflare R2)

model FileObject {
  id            Int            @id @default(autoincrement())
  publicId      String         @unique
  key           String
  url           String
  mime          String
  size          Int
  createdAt     DateTime       @default(now())
  bookingPhotos BookingPhoto[]
  customerKycs  CustomerKyc[]
  bookingKycs   Booking[]      @relation("BookingKyc")
  vehicleImages VehicleImage[]
  invoicePdfs   Invoice[]      @relation("InvoicePdf")
  cancellationInvoices  CancellationInvoice[] @relation("CancellationInvoicePdf")
  returnReceiptPdfs ReturnReceipt[] @relation("ReturnReceiptPdf")

  @@index([publicId])
}

// BRANCH & STAFF

model Branch {
  id                      Int                      @id @default(autoincrement())
  publicId                String                   @unique
  name                    String
  address                 String
  phone                   String?
  users                   User[]
  vehicles                Vehicle[]
  bookings                Booking[]
  pricingSetting          BranchPricingSetting?
  pricingDiscountSlabs    PricingDiscountSlab[]
  categoryDepositSettings CategoryDepositSetting[]
  branchPricingDefaults   BranchPricingDefaults[]
  gstRule                 GSTRule?
  featureFlags            BranchFeatureFlag[]
  captureConfigs          VehiclePhotoCaptureConfig[]
  auditLogs               AuditLog[]
  staffActivityLogs       StaffActivityLog[]
  durationDiscountSlabs   DurationDiscountSlab[]
  discountConfig          BranchDiscountConfig?
  paymentConfig           BranchPaymentConfig?
  chargeConfig            BranchChargeConfig?
  paymentTransactions     PaymentTransaction[]
  cashShifts              CashShift[]
  refundRequests          RefundRequest[]
  extensions              BookingExtension[]
  paymentSessions         PaymentSession[]
  createdAt               DateTime                 @default(now())
  deletedAt               DateTime?
}

enum StaffActionType {
  CREATED
  APPROVED
  REJECTED
  CANCELLED
  CONFIRMED
  UPDATED
  DELETED
  UPLOADED
  SWAPPED
  REFUNDED
  ASSESSED
  INITIATED
  COMPLETED
  APPLIED
  OVERRIDDEN
  RECALCULATED
  FLAGGED
  COLLECTED
  RECONCILED
  SETTLED
  DISBURSED
  EXTENDED
}

enum StaffEntityType {
  BOOKING
  INVOICE
  PAYMENT
  CUSTOMER
  VEHICLE
  KYC
  DAMAGE_REPORT
  DEPOSIT
  EMPLOYEE
  PRICING
  CAPTURE_CONFIG
  DISCOUNT_RULE
  DISCOUNT_APPLICATION
  MANUAL_DISCOUNT
  PAYMENT_TRANSACTION
  CASH_SHIFT
  REFUND_REQUEST
  BOOKING_EXTENSION
  CHARGE_ENTRY
  CHARGE_OVERRIDE
  FUEL_RECORD
  SAFETY_DEPOSIT_REQUEST
  BRANCH_CHARGE_CONFIG
  PAYMENT_SESSION
  LEDGER_ENTRY
}

// ── Rental Extension Enums ────────────────────────────────────────────────────

enum ExtensionStatus {
  PENDING_PAYMENT
  PAYMENT_COLLECTED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum ExtensionTrigger {
  CUSTOMER_BEFORE_PICKUP
  CUSTOMER_AFTER_PICKUP
  EMPLOYEE_AT_PICKUP
  EMPLOYEE_DURING_RENTAL
}

enum ExtensionResolutionType {
  SAME_VEHICLE
  SWAP_CURRENT_TO_OTHER
  SWAP_FUTURE_BOOKING
  PARTIAL_EXTENSION
  NO_RESOLUTION
}

// ── Payment Management Enums ──────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  ONLINE
  SPLIT
}

enum PaymentTransactionStatus {
  INITIATED
  COLLECTED
  CONFIRMED
  FAILED
  REJECTED
  REFUNDED
}

enum PaymentPurpose {
  ADVANCE
  REMAINING_BALANCE
  FULL_PAYMENT
  EXTENSION
  DAMAGE_FEE
  SAFETY_DEPOSIT
  OVERPAYMENT_REFUND
  CANCELLATION_REFUND
}

enum RefundStatus {
  PENDING_APPROVAL
  APPROVED
  COMPLETED
  REJECTED
}

enum CashShiftStatus {
  OPEN
  CLOSED
  DISCREPANCY_FLAGGED
}

model StaffActivityLog {
  id            Int             @id @default(autoincrement())
  publicId      String          @unique

  // Actor (de-normalised — no join needed for reads)
  actorPublicId String
  actorName     String
  actorRole     Role

  // Branch (de-normalised)
  branchId      Int
  branchName    String

  // Action
  actionType    StaffActionType
  entityType    StaffEntityType
  entityRef     String
  description   String

  // Extra structured data
  metadata      Json?

  // UTC
  createdAt     DateTime        @default(now())

  branch        Branch          @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([actorPublicId])
  @@index([actionType])
  @@index([entityType])
  @@index([createdAt])
}

model BranchPricingSetting {
  id             Int     @id @default(autoincrement())
  branchId       Int     @unique
  weekendEnabled Boolean @default(true)
  peakEnabled    Boolean @default(false)
  customEnabled  Boolean @default(false)

  weekendMultiplier Decimal @default(1.2)
  peakMultiplier    Decimal @default(1.5)
  customMultiplier  Decimal @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
}

// VEHICLES

model VehicleCategory {
  id          Int     @id @default(autoincrement())
  publicId    String  @unique
  name        String
  description String?
  rank        Int     @default(1)

  pricingDiscountSlabs    PricingDiscountSlab[]
  categoryDepositSettings CategoryDepositSetting[]
  vehicles                Vehicle[]
  pricingRules            PricingRule[]
  branchPricingDefaults   BranchPricingDefaults[]
  captureConfigs          VehiclePhotoCaptureConfig[]
}

// VEHICLE PHOTO CAPTURE CONFIG
// Branch managers configure which sides/angles to capture per vehicle category.
model VehiclePhotoCaptureConfig {
  id         Int             @id @default(autoincrement())
  publicId   String          @unique
  branchId   Int
  categoryId Int
  fields     Json            // [{ name: string, required: boolean }]

  branch     Branch          @relation(fields: [branchId], references: [id])
  category   VehicleCategory @relation(fields: [categoryId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([branchId, categoryId])
  @@index([branchId])
}

model Vehicle {
  id              Int           @id @default(autoincrement())
  publicId        String        @unique
  branchId        Int
  categoryId      Int
  make            String
  model           String
  regNo           String        @unique
  odo             Int
  fuelLevel       Int           @default(0)
  advancePayAmount Decimal      @default(0)
  insuranceExpiry DateTime
  status          VehicleStatus @default(AVAILABLE)
  fastagNumber    String?
  hasFastag       Boolean       @default(false)
  branch           Branch                     @relation(fields: [branchId], references: [id])
  category         VehicleCategory            @relation(fields: [categoryId], references: [id])
  insuranceRecords VehicleInsurance[]
  maintenance      VehicleMaintenanceRecord[]
  damageReports    DamageReport[]
  pricingOverride  VehiclePricingOverride?
  customPricing    VehicleCustomPricing?
  images           VehicleImage[]
  bookingItems     BookingItem[]
  featureFlags     VehicleFeatureFlag[]
  swapsAsOriginal  VehicleSwap[]              @relation("OriginalVehicle")
  swapsAsNew       VehicleSwap[]              @relation("NewVehicle")
  extensionSwaps   BookingExtension[]         @relation("ExtensionSwappedVehicle")
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  deletedAt        DateTime?

  @@index([branchId])
  @@index([categoryId])
  @@index([status])
  // Performance indexes
  @@index([status, deletedAt, insuranceExpiry])
  @@index([make, model])
  @@index([branchId, categoryId, status])
}

model VehiclePricingOverride {
  id          Int      @id @default(autoincrement())
  vehicleId   Int      @unique
  customPrice Decimal?
  multiplier  Decimal?
  enabled     Boolean  @default(false)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

model VehicleCustomPricing {
  id            Int      @id @default(autoincrement())
  publicId      String   @unique
  vehicleId     Int      @unique
  hourlyRate    Decimal?
  price12Hour   Decimal?
  freeKm12Hour  Int      @default(100)
  price24Hour   Decimal
  freeKm24Hour  Int      @default(150)
  priceMonthly  Decimal?
  freeKmMonthly Int      @default(1500)
  extraKmRate   Decimal  @default(8.00)
  extraHourRate Decimal  @default(100.00)
  enabled       Boolean  @default(true)

  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([vehicleId])
  @@index([enabled])
}

model BranchPricingDefaults {
  id             Int      @id @default(autoincrement())
  publicId       String   @unique
  branchId       Int
  categoryId     Int
  hourlyRate     Decimal?
  price12Hour    Decimal?
  freeKm12Hour   Int      @default(100)
  price24Hour    Decimal
  freeKm24Hour   Int      @default(150)
  priceMonthly   Decimal?
  freeKmMonthly  Int      @default(1500)
  extraKmRate    Decimal  @default(8.00)
  extraHourRate  Decimal  @default(100.00)

  branch         Branch          @relation(fields: [branchId], references: [id])
  category       VehicleCategory @relation(fields: [categoryId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([branchId, categoryId])
  @@index([branchId])
  @@index([categoryId])
}

model VehicleInsurance {
  id           Int      @id @default(autoincrement())
  publicId     String   @unique
  vehicleId    Int
  policyNumber String
  provider     String
  validTill    DateTime

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

model VehicleMaintenanceRecord {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique
  vehicleId   Int
  description String
  cost        Decimal
  servicedAt  DateTime

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

model VehicleImage {
  id          Int     @id @default(autoincrement())
  publicId    String  @unique
  vehicleId   Int
  fileId      Int
  isThumbnail Boolean @default(false)

  vehicle Vehicle    @relation(fields: [vehicleId], references: [id])
  file    FileObject @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([fileId])
  // Performance index
  @@index([vehicleId, isThumbnail])
}

// BOOKINGS

model PricingRule {
  id         Int             @id @default(autoincrement())
  publicId   String          @unique
  ruleType   PricingRuleType
  multiplier Decimal
  categoryId Int?

  category  VehicleCategory? @relation(fields: [categoryId], references: [id])
  createdAt DateTime         @default(now())
}

model PricingDiscountSlab {
  id         Int     @id @default(autoincrement())
  days       Int
  multiplier Decimal
  branchId   Int?
  categoryId Int?

  branch   Branch?          @relation(fields: [branchId], references: [id])
  category VehicleCategory? @relation(fields: [categoryId], references: [id])
}

model CategoryDepositSetting {
  id         Int     @id @default(autoincrement())
  branchId   Int
  categoryId Int
  amount     Decimal

  branch   Branch          @relation(fields: [branchId], references: [id])
  category VehicleCategory @relation(fields: [categoryId], references: [id])

  @@unique([branchId, categoryId])
}

model Booking {
  id              Int            @id @default(autoincrement())
  publicId        String         @unique
  customerId      Int
  branchId        Int
  startAt         DateTime
  endAt           DateTime
  days            Int
  rentalPeriodType   RentalPeriodType?
  actualHours        Decimal?
  billableHours      Decimal?
  startOdometer      Int?
  endOdometer        Int?
  totalKmDriven      Int?
  freeKmLimit        Int?
  extraKmCharged     Int?
  holdExpiresAt   DateTime?
  totalBase       Decimal
  totalDiscount   Decimal
  totalDeposit    Decimal
  totalTax        Decimal        @default(0)
  totalFinal      Decimal
  status          BookingStatus  @default(HOLD)
  transactionId   String?        @unique
  paymentStatus   PaymentStatus  @default(CREATED)
  pricingSnapshot Json
  createdById     Int
  depositMethod   DepositMethod?
  kycFileId       Int?
  kycFile         FileObject?    @relation("BookingKyc", fields: [kycFileId], references: [id])
  customer        Customer       @relation(fields: [customerId], references: [id])
  branch          Branch         @relation(fields: [branchId], references: [id])
  createdBy       User           @relation("BookingCreator", fields: [createdById], references: [id])

  photos  BookingPhoto[]
  damages DamageReport[]
  items   BookingItem[]
  deposit Deposit?
  invoice Invoice?
  cancellationInvoice CancellationInvoice?
  returnReceipt ReturnReceipt?
  vehicleSwaps VehicleSwap[]

  // Advance Payment Tracking
  isAdvancePayment      Boolean        @default(false)
  advanceAmount         Decimal        @default(0)
  advancePaidAt         DateTime?
  advancePaymentId      String?
  advancePaymentMode    DepositMethod?

  // Remaining Balance (after advance is collected)
  remainingBalance      Decimal        @default(0)
  remainingPaidAt       DateTime?
  remainingPaymentId    String?        @unique
  remainingPaymentMode  DepositMethod?
  remainingPaidDuring   String?        // "PICKUP" | "RETURN"

  // Safety Deposit Tracking
  safetyDeposit         Decimal   @default(0)
  safetyDepositPaidAt   DateTime?
  safetyDepositMethod   DepositMethod?
  safetyDepositRefunded Boolean   @default(false)
  safetyDepositRefundedAt DateTime?
  safetyDepositSetOff   Boolean   @default(false)

  // Cancellation Tracking
  cancelledAt        DateTime?
  cancellationReason String?

  // Manager Confirmation Flag
  requiresManagerConfirmation Boolean @default(false)

  // Discount Tracking
  couponCode            String?
  discountRuleId        Int?
  discountRule          DiscountRule?          @relation(fields: [discountRuleId], references: [id])
  discountApplication   DiscountApplication?
  manualDiscount        ManualDiscount?

  // Payment Tracking
  paymentTransactions   PaymentTransaction[]
  refundRequests        RefundRequest[]

  // Extension Tracking
  originalEndAt         DateTime?           // Set once on first extension, never changed again
  extensionCount        Int                 @default(0)
  lastExtendedAt        DateTime?
  activeExtensionId     Int?                // FK to BookingExtension — non-null while a pending extension exists
  activeExtension       BookingExtension?   @relation("ActiveExtension", fields: [activeExtensionId], references: [id])
  extensions            BookingExtension[]  @relation("BookingExtensions")

  // Displacement tracking — set when this booking's vehicle was changed due to another booking's extension
  displacedByExtensionId Int?
  extensionDisplacedAt   DateTime?

  // Charge Engine — config frozen at booking creation (immutable snapshot)
  frozenChargeConfig  Json?
  chargeConfigVersion Int   @default(1)

  // Charge Engine relations
  chargeEntries          ChargeEntry[]
  chargeOverrides        ChargeOverride[]
  fuelRecord             FuelRecord?
  safetyDepositRequest   SafetyDepositRequest?

  // Payment Session (ledger-based financial flow)
  activePaymentSessionId Int?
  activePaymentSession   PaymentSession?  @relation("ActiveBookingSession", fields: [activePaymentSessionId], references: [id])
  paymentSessions        PaymentSession[] @relation("BookingPaymentSessions")
  ledgerEntries          LedgerEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([branchId])
  @@index([createdById])
  @@index([status])
  @@index([startAt, endAt])
  @@index([advancePaymentId])
  @@index([remainingPaymentId])
  @@index([cancelledAt])
  @@index([activeExtensionId])
  @@index([displacedByExtensionId])
  @@index([activePaymentSessionId])
  // Performance index
  @@index([status, startAt, endAt])
  @@index([rentalPeriodType])
  @@index([discountRuleId])
  @@index([couponCode])
}

model BookingItem {
  id        Int @id @default(autoincrement())
  bookingId Int
  vehicleId Int

  days            Int
  baseTotal       Decimal
  discountAmount  Decimal
  discountPercent Decimal
  deposit         Decimal
  taxAmount       Decimal @default(0)
  cgstAmount      Decimal @default(0)
  sgstAmount      Decimal @default(0)
  taxRate         Decimal @default(0)
  finalTotal      Decimal

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([vehicleId])
  // Performance index
  @@index([vehicleId, bookingId])
}

model BookingPhoto {
  id             Int              @id @default(autoincrement())
  publicId       String           @unique
  bookingId      Int
  fileId         Int
  type           BookingPhotoType
  captureLabel   String?          // e.g. "Front", "Left Side" — set when uploaded via capture config
  damageReportId Int?

  booking      Booking       @relation(fields: [bookingId], references: [id])
  file         FileObject    @relation(fields: [fileId], references: [id])
  createdAt    DateTime      @default(now())
  damageReport DamageReport? @relation(fields: [damageReportId], references: [id])

  @@index([bookingId])
  @@index([fileId])
}

model DamageReport {
  id            Int                       @id @default(autoincrement())
  publicId      String                    @unique
  bookingId     Int
  vehicleId     Int
  severity      String
  estimatedCost Decimal
  finalCost     Decimal?
  notes         Json
  approvedById  Int?
  chargeType    DamageChargeType          @default(PENALTY)
  status        DamageReportStatus        @default(PENDING)
  disposition   VehicleReturnDisposition?
  booking       Booking                   @relation(fields: [bookingId], references: [id])
  vehicle       Vehicle                   @relation(fields: [vehicleId], references: [id])
  approvedBy    User?                     @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  photos        BookingPhoto[]

  createdAt DateTime @default(now())
}

// DEPOSIT & PAYMENTS

model Deposit {
  id           Int           @id @default(autoincrement())
  publicId     String        @unique
  bookingId    Int           @unique
  amount       Decimal
  method       DepositMethod
  isRefunded   Boolean       @default(false)
  refundedAt   DateTime?
  refundMethod String?

  booking   Booking  @relation(fields: [bookingId], references: [id])
  createdAt DateTime @default(now())
}

model Payment {
  id                Int           @id @default(autoincrement())
  publicId          String        @unique
  invoiceId         Int
  method            DepositMethod // ONLINE_RAZORPAY or CASH/UPI
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            PaymentStatus
  amount            Decimal

  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
}

model PaymentWebhookLog {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique
  payload   Json
  signature String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

// INVOICE

model Invoice {
  id            Int           @id @default(autoincrement())
  publicId      String        @unique
  bookingId     Int           @unique
  subtotal      Decimal
  discount      Decimal
  tax           Decimal
  damageCharges Decimal
  total         Decimal
  status        InvoiceStatus @default(PENDING)

