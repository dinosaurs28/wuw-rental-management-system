model ReturnReceipt {
  id             Int      @id @default(autoincrement())
  publicId       String   @unique
  bookingId      Int      @unique
  receiptNumber  String?  @unique

  // Line items as JSON: [{label, amount, chargeType}]
  lineItems      Json     @default("[]")

