  refundAmount   Decimal  @default(0)   // customer gets this back

  // PDF
  receiptPdfFileId Int?
  receiptPdfFile   FileObject? @relation("ReturnReceiptPdf", fields: [receiptPdfFileId], references: [id], onDelete: SetNull)
