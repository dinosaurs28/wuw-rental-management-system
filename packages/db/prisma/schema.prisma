// AUDIT LOG

enum AuditCategory {
  BOOKING
  PAYMENT
  VEHICLE
  CUSTOMER
  EMPLOYEE
  BRANCH
  AUTH
  SYSTEM
  DISCOUNT
  CHARGE
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

model AuditLog {
  id            Int           @id @default(autoincrement())
  publicId      String        @unique

  // Identity & Actor
  actorId       Int?
  actorName     String        @default("")
  actorRole     Role          @default(CUSTOMER)
  actorBranchId Int?

  // Approver (staff who processed a customer-initiated action)
  approverId    Int?
  approverName  String?
  approverRole  Role?

  // Action Details
  action        String
  category      AuditCategory @default(SYSTEM)
  severity      AuditSeverity @default(INFO)
  description   String        @default("")

  // Entity
  entity        String
  entityId      String
  entityLabel   String?

  // Context
  ipAddress     String?
  userAgent     String?
  requestId     String?

  // Data Changes
  before        Json?
  after         Json?
  changedFields String[]

  // Domain-specific extra data
  metadata      Json?

  // Timestamps (UTC)
  createdAt     DateTime      @default(now())

  actor       User?   @relation("ActorAuditLogs", fields: [actorId], references: [id])
  approver    User?   @relation("ApproverAuditLogs", fields: [approverId], references: [id])
  actorBranch Branch? @relation(fields: [actorBranchId], references: [id])
}

// SYSTEM SETTINGS

model SystemSetting {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model WhatsAppSupportConfig {
