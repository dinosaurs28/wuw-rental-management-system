// FEATURE FLAGS

enum FeatureFlagScope {
  SYSTEM
  BRANCH
  VEHICLE
}

model FeatureFlag {
  id          Int               @id @default(autoincrement())
  publicId    String            @unique
  key         String            @unique
  name        String
  description String?
  scope       FeatureFlagScope
  enabled     Boolean           @default(false)
  config      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchFlags  BranchFeatureFlag[]
  vehicleFlags VehicleFeatureFlag[]

  @@index([key])
  @@index([scope])
  @@index([enabled])
}

model BranchFeatureFlag {
