{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node --input-type=module --eval \"import{cpSync}from'node:fs';cpSync('src/generated','dist/generated',{recursive:true});\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "report": "tsx scripts/vrms-report.ts",
    "cleanup": "tsx scripts/cleanup-transactions.ts",
    "seed:vehicles": "tsx scripts/seed-vehicles.ts"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.19.25",
    "dotenv": "^16.3.1",
    "dotenv-cli": "^11.0.0",
    "nanoid": "^5.1.6",
    "prisma": "5.22.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "xlsx": "^0.18.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  }
}