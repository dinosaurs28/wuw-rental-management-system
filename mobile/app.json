{
  "expo": {
    "name": "WUW Rentals",
    "slug": "wuw",
    "version": "1.0.0",
    "scheme": "wuw",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#04040e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wuw.cars"
    },
    "android": {
      "package": "com.wuw.cars",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#04040e"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WUW needs access to your photos to upload KYC documents."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "WUW needs camera access to scan booking QR codes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "networkSecurityConfig": "./android-network-security-config.xml"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e96247c6-c93e-4d56-94d9-04431ef454ff"
      }
    },
    "owner": "sushanshetty"
  }
}
