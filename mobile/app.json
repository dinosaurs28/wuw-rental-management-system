{
  "expo": {
    "name": "WUW Rentals",
    "slug": "wuw-cars",
    "version": "1.0.0",
    "scheme": "wuw",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0a0a0a",
    "primaryColor": "#ff6a1f",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.whatuwantrentals.rentals",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.whatuwantrentals.rentals",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0a",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      "expo-audio",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WUW needs access to your photos so you can upload your driving licence and other KYC documents.",
          "cameraPermission": "WUW needs camera access so you can photograph your driving licence and vehicle condition.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "WUW needs camera access to scan booking QR codes and capture vehicle condition photos.",
          "microphonePermission": false,
          "recordAudioAndroidPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "networkSecurityConfig": "./android-network-security-config.xml"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05793a28-9b7b-4db6-8b2d-75f22fd68de4"
      }
    },
    "owner": "dinosaurs28"
  }
}
