{
  "expo": {
    "name": "WUW Cars",
    "slug": "wuw-cars",
    "version": "1.0.0",
    "scheme": "wuw",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wuw.cars"
    },
    "android": {
      "package": "com.wuw.cars",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0a",
          "image": "./assets/icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WUW needs access to your photos to upload KYC documents."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "WUW needs camera access to scan booking QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ddb96052-cb64-4baf-a780-dccbfaeb6284"
      }
    },
    "owner": "sushanshetty"
  }
}
