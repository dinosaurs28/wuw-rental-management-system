# Backend API base URL.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth — required for the "Continue with Google" button to render
# on the auth screens. The button auto-hides if none of these are set.
# Provision via Google Cloud Console → Credentials. The web client ID must
# match the backend's GOOGLE_WEB_CLIENT_ID so token audience verification
# succeeds. Note: Expo bakes EXPO_PUBLIC_* vars into the native build at
# build time; rerun `npx expo run:ios` / `run:android` after changes.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# WhatsApp deep link target — phone number in international format,
# digits only (e.g. 919876543210). When unset, the WhatsApp FAB on
# bookings/checkout/trip detail is hidden.
EXPO_PUBLIC_WHATSAPP_NUMBER=
