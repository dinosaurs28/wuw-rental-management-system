# ── Server ────────────────────────────────────────────────────────────────────
# NOTE: the leading underscore is load-bearing — index.ts reads process.env._PORT,
# NOT PORT. On a host that injects PORT automatically (DigitalOcean App Platform
# does), you must still set _PORT or the server binds to a random port.
_PORT=8000

# ── Data stores ───────────────────────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
# NOTE: the misspelling "SECERT" is load-bearing — it is what the code reads.
JWT_SECERT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# ── Payments: Razorpay ────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys.
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=
# Server-side only. Signs orders and verifies Checkout responses. NEVER expose
# this to a client.
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. A SEPARATE secret from KEY_SECRET — you
# choose it when creating the webhook. Without it every delivery is rejected 400.
# Subscribe the endpoint to: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# The webhook URL itself is NOT read from the environment — register it by hand
# in the Razorpay dashboard, pointing at:
#   https://<this-api-host>/api/payment/razorpay/webhook
# See docs/RAZORPAY_SETUP.md.

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_REDIRECT_URL=

# ── SMS / OTP ─────────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_URL=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
OTP_SENDER_EMAIL=

# ── Object storage (Cloudflare R2) ────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Company details (shown on invoices / emails) ──────────────────────────────
COMPANY_EMAIL=
COMPANY_PHONE=
